# ---- AgentOS configuration (copy to .env and fill in) ----
# All values here are placeholders. Never commit a real .env.

# Core
AGENTOS_ENV=development                       # development | test | production
AGENTOS_SECRET_KEY=change-me-to-a-long-random-string
AGENTOS_API_HOST=127.0.0.1
AGENTOS_API_PORT=8000
# Comma-separated list of allowed browser origins
AGENTOS_FRONTEND_ORIGIN=http://localhost:3000

# Database (async driver)
AGENTOS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentos
# Used by tests (separate database, dropped/recreated freely)
AGENTOS_TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentos_test

# Redis
AGENTOS_REDIS_URL=redis://localhost:6379/0

# LLM provider: anthropic | none
# "none" = deterministic mode only (no LLM calls anywhere).
AGENTOS_LLM_PROVIDER=none
AGENTOS_ANTHROPIC_API_KEY=
AGENTOS_LLM_MODEL=claude-sonnet-5-5

# Embeddings provider: voyage | openai | local-hash
# local-hash is a deterministic lexical embedding for offline demos/tests —
# it is labeled as such in the UI and is NOT a semantic model.
AGENTOS_EMBEDDINGS_PROVIDER=local-hash
AGENTOS_VOYAGE_API_KEY=
AGENTOS_OPENAI_API_KEY=

# Uploads
AGENTOS_UPLOAD_DIR=./var/uploads
AGENTOS_MAX_UPLOAD_BYTES=26214400            # 25 MB
AGENTOS_MAX_REQUEST_BYTES=10485760           # 10 MB

# Execution limits (per run unless stated)
AGENTOS_MAX_PLAN_TASKS=8
AGENTOS_MAX_TOOL_CALLS_PER_TASK=15
AGENTOS_MAX_LLM_CALLS_PER_RUN=40
AGENTOS_RUN_TIMEOUT_S=600
AGENTOS_TASK_TIMEOUT_S=180
AGENTOS_MAX_REVIEW_ITERATIONS=2

# MCP servers config file (JSON). See docs/architecture.md §5.
AGENTOS_MCP_CONFIG_PATH=./mcp.servers.json
