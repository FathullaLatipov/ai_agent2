# ---- AgentOS STAGING configuration (copy to .env.staging and fill in) ----
# Placeholders only. Never commit a real .env.staging.
# AGENTOS_ENV=production activates the fail-fast config guard: the API refuses
# to boot on an example/short secret key.

AGENTOS_ENV=production
# The guard refuses to boot while "change-me" is present — replace the WHOLE value.
AGENTOS_SECRET_KEY=change-me-generate-a-random-48-character-secret
AGENTOS_FRONTEND_ORIGIN=http://127.0.0.1:3800

# In-cluster service names (compose network); CHANGE the postgres password and
# keep both services unpublished (the staging overlay exposes no DB/Redis ports).
POSTGRES_PASSWORD=choose-a-strong-db-password
AGENTOS_DATABASE_URL=postgresql+asyncpg://postgres:choose-a-strong-db-password@postgres:5432/agentos
AGENTOS_REDIS_URL=redis://redis:6379/0

# Deterministic mode unless a real key is provisioned (never paste keys in chat).
AGENTOS_LLM_PROVIDER=none
AGENTOS_ANTHROPIC_API_KEY=
AGENTOS_EMBEDDINGS_PROVIDER=local-hash

AGENTOS_UPLOAD_DIR=/srv/backend/var/uploads

# Demo seed (scripts.seed) is DEVELOPMENT-ONLY demo data with a known password.
# Only seed a staging stack that is private and will be wiped.
